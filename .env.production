# 代理前缀
VITE_APP_BASE_API = '/prod-api'
# 应用名称（侧边栏/登录页/水印等展示的平台名）
VITE_APP_NAME=Lrcore云平台
# 项目名称（浏览器标签页标题）
VITE_APP_TITLE=Lrcore云平台

# 多租户开关(true/false)
VITE_APP_TENANT_ENABLED=false

# 子门户地址：SSO 登录成功后展示的「子系统选择门户」页（AS 侧 /sso/portal.html）
# 顶栏「返回子门户」入口依赖此配置；留空则不展示该入口
VITE_APP_PORTAL_URL=

# SSO 自动登录(true/false)：true 时未登录访问受保护路由将自动发起 SSO 授权码流程
# （免登直达后台，不再停在登录页）；false 时保留原登录页手动点“SSO 单点登录”
VITE_APP_SSO_AUTO=true

# SSO 单点登录：授权服务器 issuer（浏览器直连 AS 取令牌，不经网关）
#VITE_SSO_ISSUER=

